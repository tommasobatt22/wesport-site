---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- L'onda del brand: un solo profilo, riusato come maschera di ogni forma e foto -->
  <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <!-- bordo sinistro ondulato (forme ancorate a destra) -->
      <clipPath id="wave-r" clipPathUnits="objectBoundingBox">
        <path d="M1,0 L1,1 L0.14,1 C0.02,0.83 0.26,0.67 0.14,0.5 C0.02,0.33 0.26,0.17 0.14,0 Z" />
      </clipPath>
      <!-- bordo destro ondulato (forme ancorate a sinistra) -->
      <clipPath id="wave-l" clipPathUnits="objectBoundingBox">
        <path d="M0,0 L0.86,0 C0.74,0.17 0.98,0.33 0.86,0.5 C0.74,0.67 0.98,0.83 0.86,1 L0,1 Z" />
      </clipPath>
      <!-- bordo superiore ondulato (forme ancorate in basso, per il telefono) -->
      <clipPath id="wave-t" clipPathUnits="objectBoundingBox">
        <path d="M0,1 L0,0.12 C0.17,0.02 0.33,0.26 0.5,0.12 C0.67,0 0.83,0.26 1,0.12 L1,1 Z" />
      </clipPath>
    </defs>
  </svg>
  <div class="page">
    <slot />
  </div>

  <script>
    // Entrata a gradini: titolo, testo, immagine. Se lo script non gira, tutto resta visibile.
    const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!still && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('js-reveal');
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -6% 0px' }
      );
      items.forEach((el) => {
        const group = el.closest('[data-stagger]');
        if (group) {
          const idx = Array.from(group.querySelectorAll('[data-reveal]')).indexOf(el);
          el.style.setProperty('--d', `${idx * 80}ms`);
        }
        io.observe(el);
      });
    }

    // Cornice del claim: tocco = foto successiva subito
    const frame = document.querySelector<HTMLElement>('[data-cycle]');
    if (frame) {
      const slides = Array.from(frame.querySelectorAll<HTMLElement>('.cycle__slide'));
      const words = Array.from(document.querySelectorAll<HTMLElement>('[data-cycle-word]'));
      let i = 0;
      const show = (n: number) => {
        i = (n + slides.length) % slides.length;
        slides.forEach((s, k) => s.classList.toggle('is-on', k === i));
        words.forEach((w, k) => w.classList.toggle('is-on', k === i % words.length));
      };
      let timer = setInterval(() => show(i + 1), 2800);
      frame.addEventListener('click', () => {
        clearInterval(timer);
        show(i + 1);
        timer = setInterval(() => show(i + 1), 2800);
      });
      show(0);
    }
  </script>
</body>
</html>
