<section id="top" class="hero">
  <figure class="hero__media">
    <video autoplay muted loop playsinline poster="/assets/img/hero.jpg" aria-hidden="true">
      <source src="/assets/video/we-sport-home-video-mobile.mp4" media="(max-width: 700px)" type="video/mp4" />
      <source src="/assets/video/we-sport-home-video.mp4" type="video/mp4" />
    </video>
  </figure>
  <div class="hero__intro">
    <div class="hero__heading">
      <div class="eyebrow text-sm">A.S.D. WE SPORT · Castelfranco Veneto</div>
      <h1 class="hero__title text-5xl">Together,<br /><span class="outline">we move.</span></h1>
    </div>
    <div class="hero__body">
      <p class="hero__lead text-xl">Lo sport per tutti, senza barriere</p>
      <div class="hero__actions">
        <a href="#discipline" class="btn">Scopri le discipline</a>
        <a href="#contatti" class="btn btn--ghost">Contattaci</a>
      </div>
    </div>
  </div>
